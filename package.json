{
  "name": "llc-design-plugin",
  "version": "0.1.0",
  "description": "DSH plugin: LLC resonant converter transformer/design tool (user proprietary algorithm engine)",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup src/index.ts --format esm --dts --out-dir lib --clean",
    "dev": "pnpm dsh web --patch ./cordis.yml"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
